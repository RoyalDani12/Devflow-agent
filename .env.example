TELEGRAM_BOT_TOKEN=your_telegram_token
GROQ_API_KEY=your_groq_api_key

# Destination channel or group where approved posts will be broadcast
TELEGRAM_PUBLISH_CHAT_ID=

# Admin chat ID where the autonomous agent sends proactive daily drafts for review
TELEGRAM_REVIEW_CHAT_ID=

# Set to true to allow the agent to publish automatically without waiting for review click
AUTO_PUBLISH=false

# Optional external web search provider (e.g. Tavily API)
TAVILY_API_KEY=
